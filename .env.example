# Database (SQLite file for local dev and the demo)
DATABASE_URL="file:./dev.db"

# Demo sign-in: lists seeded users by role so the demo runs without OAuth. Default on.
# Anyone can act as any seeded person, admin included. Never use it on a public deploy: set
# DEMO_MODE=false and a real AUTH_SECRET. It switches off by itself when GitHub sign-in is configured.
DEMO_MODE=true

# Auth.js secret. Optional in demo mode (a fixed demo secret is used); required otherwise.
# Generate one with: npx auth secret
AUTH_SECRET=

# GitHub sign-in. Leave empty to use demo sign-in only.
GITHUB_ID=
GITHUB_SECRET=

# GitHub API for repo evidence. Optional; without it public repos use the unauthenticated rate limit,
# and seeded commit data is shown when the API isn't reachable.
GITHUB_TOKEN=

# Evidence summary. Without a key the seeded summary is shown.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
